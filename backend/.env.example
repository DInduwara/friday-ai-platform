# Copy to backend/.env and fill values

FRIDAY_ENV=dev
FRIDAY_LOG_LEVEL=INFO

# CORS
FRIDAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model / APIs
GROQ_API_KEY=
FRIDAY_GROQ_MODEL=llama-3.3-70b-versatile

OPENWEATHER_API_KEY=
TODOIST_API_KEY=

# Tracing
FRIDAY_FULL_AI_TRACE=false
