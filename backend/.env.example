# Copy to backend/.env and fill values

FRIDAY_ENV=dev
FRIDAY_LOG_LEVEL=INFO

# CORS
FRIDAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model / APIs
GROQ_API_KEY=
FRIDAY_GROQ_MODEL=llama-3.3-70b-versatile

OPENWEATHER_API_KEY=
TODOIST_API_KEY=

# Tracing
FRIDAY_FULL_AI_TRACE=false

# Redis conversation memory
FRIDAY_REDIS_URL=redis://redis:6379/0
FRIDAY_MEMORY_TTL_SECONDS=86400
FRIDAY_MEMORY_BACKEND=redis

FRIDAY_CLERK_ISSUER=
FRIDAY_CLERK_JWKS_URL=